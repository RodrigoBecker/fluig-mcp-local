        { "CODIGO": "3001", "DESCRICAO": "Controladoria", "RESPONSAVEL": "jsouza", "BLOQUEADO": "N" },
        { "CODIGO": "9001", "DESCRICAO": "Projetos Encerrados", "RESPONSAVEL": "pcosta", "BLOQUEADO": "S" }
      ]
    },
    "ds_fornecedores": {
      "description": "Dataset customizado: fornecedores (SA2) via integração REST com Protheus",
      "type": "CUSTOM",
      "columns": ["CODIGO", "LOJA", "RAZAO_SOCIAL", "CNPJ", "UF"],
